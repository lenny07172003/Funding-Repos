# Resend Email API
# Sign up at https://resend.com and get your API key from the dashboard
RESEND_API_KEY=re_your_api_key_here

# The "from" email address for outgoing emails
# Default: "Business Funding CRM <onboarding@resend.dev>" (Resend test domain)
# For production, verify your own domain at https://resend.com/domains
RESEND_FROM_EMAIL="Business Funding CRM <onboarding@resend.dev>"
